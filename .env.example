# Copie para .env (desenvolvimento). Em produção, cadastre no Coolify. Nunca commite valores reais.

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
APP_URL=http://localhost:5173
# Endereço do portal do cliente (opcional; sem ele o portal fica desligado). Ex.: https://portal.aledias.com.br
PORTAL_URL=
API_URL=http://localhost:3000

# Senhas dos papéis criados no primeiro start do Postgres local (docker/postgres/init.sh).
LEADTOGO_OWNER_PASSWORD=senha
LEADTOGO_APP_PASSWORD=senha

# Banco (usuário da aplicação: sem BYPASSRLS, não é dono das tabelas)
DATABASE_URL=postgres://leadtogo_app:senha@localhost:5432/leadtogo
# Banco (usuário de migração: dono das tabelas)
DATABASE_MIGRATION_URL=postgres://leadtogo_owner:senha@localhost:5432/leadtogo

# Testes de banco (packages/db): banco separado, criado por `pnpm dev:up`
TEST_DATABASE_URL=postgres://leadtogo_app:senha@localhost:5432/leadtogo_test
TEST_DATABASE_MIGRATION_URL=postgres://leadtogo_owner:senha@localhost:5432/leadtogo_test

# Testes da API (apps/api): banco e Valkey separados dos de desenvolvimento e dos testes do packages/db
TEST_API_DATABASE_URL=postgres://leadtogo_app:senha@localhost:5432/leadtogo_api_test
TEST_API_DATABASE_MIGRATION_URL=postgres://leadtogo_owner:senha@localhost:5432/leadtogo_api_test
TEST_REDIS_URL=redis://localhost:6379/1

# Papel do container (imagem de produção, CMD node dist/iniciar.js): api (padrão; migra o banco, semeia as
# referências e sobe a API; exige DATABASE_MIGRATION_URL) ou worker (não migra). Ver docs/runbook_e13.md
# PAPEL=api
# SEMEAR_REFERENCIAS=false desliga a semeadura de referências ao iniciar a API
# Cache e filas
REDIS_URL=redis://localhost:6379
# Worker (filas BullMQ no Valkey). WORKER_ENCERRAMENTO_S precisa ser menor que o stop timeout do container.
# Em produção o Coolify ignora --stop-timeout (Docker: 10 s), então lá use WORKER_ENCERRAMENTO_S=8: esteira_deploy.md, 7.1.1
FILA_PREFIXO=leadtogo:fila
WORKER_CONCORRENCIA=5
WORKER_ENCERRAMENTO_S=30
WORKER_SAUDE_PORTA=3001
# Ciclo do relay do outbox e e-mail pela fila (tentativas; espera base, que dobra a cada tentativa)
OUTBOX_INTERVALO_MS=2000
EMAIL_TENTATIVAS=6
EMAIL_ESPERA_MS=5000
# Limite (ms) de conexão e de envio por SMTP: o convite é enviado dentro de uma transação do banco
SMTP_TIMEOUT_MS=10000
# Chave AES-256 que cifra os e-mails de identidade na fila (gere com: openssl rand -base64 32). Obrigatória em produção
TOKEN_ENCRYPTION_KEY=
# Rate limit por IP (Valkey): requisições por janela, no total da API
RATE_LIMIT_MAX=300
RATE_LIMIT_JANELA_S=60
# Proxies na frente da API (Traefik do Coolify). Padrão: 1 em produção, 0 fora dela
# TRUST_PROXY=1

# Arquivos (Garage / S3)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=leadtogo-arquivos
S3_FORCE_PATH_STYLE=true
# Chave de desenvolvimento (docker/garage/init.sh a importa no Garage local).
# Formato do Garage: "GK" + 24 hex e 64 hex. Em produção, gere outra no Coolify.
S3_ACCESS_KEY=GKd0d0d0d0d0d0d0d0d0d0d0d0
S3_SECRET_KEY=d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0
# Endereço do Garage que o navegador alcança (só para as URLs assinadas dos anexos dos chamados).
# Vazio em desenvolvimento: vale o S3_ENDPOINT. Em produção: https://files.crm.aledias.com.br
S3_PUBLIC_ENDPOINT=
# Antivírus dos anexos (ClamAV/clamd). Vazio = anexos dos chamados desligados.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
# Push do portal (Web Push/VAPID). Vazio = push desligado. Gere o par com: npx web-push generate-vapid-keys
# Na API e no worker; VAPID_SUBJECT é o contato do remetente (mailto:... ou https://...).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# E-mail (SMTP). Em desenvolvimento: Mailpit do compose (interface em http://localhost:8025).
# Produção: Resend (smtp.resend.com, porta 465, SMTP_SECURE=true, usuário resend, senha = API key); ver docs/runbook_e13.md.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Leadtogo <nao-responder@leadtogo.local>"
# API HTTP do Mailpit (só os testes usam, para ler as mensagens enviadas)
MAILPIT_URL=http://localhost:8025

# Autenticação (Better Auth). O segredo assina cookies e cifra o 2FA (mín. 32 caracteres).
# Em produção gere um forte: openssl rand -base64 32. O valor abaixo é só de desenvolvimento.
BETTER_AUTH_SECRET=segredo-de-desenvolvimento-nao-use-em-producao
# Exige e-mail verificado para entrar. Padrão: sim em produção, não fora (precisa de SMTP)
# VERIFICACAO_EMAIL=true

# Criptografia de tokens de integrações (AES-256-GCM, 32 bytes em base64)
TOKEN_ENCRYPTION_KEY=

# Consulta de CNPJ na Receita. Os padrões abaixo já servem para produção; só mude para usar uma instância
# própria da Minha Receita. A BrasilAPI é a segunda tentativa (ela repassa a Minha Receita).
MINHA_RECEITA_URL=https://minhareceita.org
BRASILAPI_URL=https://brasilapi.com.br/api/cnpj/v1
# Tempo máximo de cada consulta, em milissegundos
RECEITA_TIMEOUT_MS=8000

# Geolocalização (docs/plano_geolocalizacao.md)
# Nominatim local só do ES (serviço do Coolify, rede interna). Vazio = sem Nominatim (desenvolvimento): a
# cascata segue só com o CNEFE e o CEP
NOMINATIM_URL=
NOMINATIM_TIMEOUT_MS=8000
# Consulta de CEP: só o CEP sai do Leadtogo
VIACEP_URL=https://viacep.com.br/ws
BRASILAPI_CEP_URL=https://brasilapi.com.br/api/cep/v1
CEP_TIMEOUT_MS=8000
# Banco: pool da API (o worker usa 10) e a rede de segurança do Postgres (consulta e transação presas)
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=30000
# URL pública do mapa base (bucket público do Garage em mapa.crm.aledias.com.br), com o nome versionado, ex.:
# https://mapa.crm.aledias.com.br/es-20261021.pmtiles. Obrigatória em produção (docs/roteiro_mapa_publico.md);
# vazio em desenvolvimento = o mapa abre sem a base (fundo liso)
MAPA_BASE_URL=
# Geocodificar sozinho a empresa nova ou com o endereço alterado (padrão ligado)
GEO_AUTOMATICA=true
# UF que as regiões e o mapa mostram por padrão
GEO_UF=ES
# Geocodificações ao mesmo tempo no worker (padrão 1) e limite por minuto
GEO_CONCORRENCIA=1
GEO_LIMITE_POR_MINUTO=120
# Dias de validade do cache das consultas externas (Nominatim e CEP) em geo_consultas
GEO_CACHE_DIAS=90

# Rotas (G4): VROOM e OSRM da pilha leadtogo-rotas (só a API usa). Vazios = otimização desligada
# ("Otimização de rotas ainda não configurada") e estimativas em linha reta. Desenvolvimento:
# docker compose -f scripts/geo/rotas-compose.yml (docs/roteiro_rotas_producao.md) e
# VROOM_URL=http://localhost:3000, OSRM_URL=http://localhost:5000 com as portas publicadas
VROOM_URL=
OSRM_URL=
# Paradas por rota (no máximo 30) e prazo de cada chamada ao VROOM/OSRM, em segundos
ROTA_MAX_PARADAS=30
ROTA_TEMPO_LIMITE_S=10

# Observabilidade
# DSN do projeto leadtogo-api no GlitchTip (API e worker). Vazio = envio de erros desligado
SENTRY_DSN=
# Token do GET /health/alertas (header X-Alertas-Token; openssl rand -hex 32). Vazio = endpoint desligado (404)
ALERTAS_TOKEN=
# Web: o DSN do projeto leadtogo-web entra no BUILD (build arg VITE_SENTRY_DSN, Variable SENTRY_DSN_WEB do GitHub).
# Fora do CI não precisa definir. Source maps: SENTRY_AUTH_TOKEN (secret do GitHub, só no CI), SENTRY_URL e SENTRY_ORG.
# VITE_SENTRY_DSN=
# Falhas finais de jobs (últimas 24 h) a partir das quais o /health/alertas responde 503
# ALERTAS_LIMITE_JOBS_FALHOS=1
APP_VERSION=dev

# Integrações (fases futuras)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
N8N_WEBHOOK_URL=
GOOGLE_MAPS_API_KEY=
# Cadastro público (POST /v1/primeiro-acesso): aberto | fechado. Padrão: aberto fora de produção e
# FECHADO em produção; lá a primeira conta nasce por `node dist/criar-conta.js` (esteira_deploy.md, 7.3)
# PRIMEIRO_ACESSO=fechado

# Login com Google (desligado por padrão). Ligar: LOGIN_GOOGLE=true com o cliente OAuth do Google Cloud
# (URI de redirecionamento: <API_URL>/v1/auth/callback/google). Só entra quem já tem conta.
# LOGIN_GOOGLE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
