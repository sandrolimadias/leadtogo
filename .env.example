# Copie para .env (desenvolvimento). Em produção, cadastre no Coolify. Nunca commite valores reais.

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Senhas dos papéis criados no primeiro start do Postgres local (docker/postgres/init.sh).
LEADTOGO_OWNER_PASSWORD=senha
LEADTOGO_APP_PASSWORD=senha

# Banco (usuário da aplicação: sem BYPASSRLS, não é dono das tabelas)
DATABASE_URL=postgres://leadtogo_app:senha@localhost:5432/leadtogo
# Banco (usuário de migração: dono das tabelas)
DATABASE_MIGRATION_URL=postgres://leadtogo_owner:senha@localhost:5432/leadtogo

# Testes de banco (packages/db): banco separado, criado por `pnpm dev:up`
TEST_DATABASE_URL=postgres://leadtogo_app:senha@localhost:5432/leadtogo_test
TEST_DATABASE_MIGRATION_URL=postgres://leadtogo_owner:senha@localhost:5432/leadtogo_test

# Testes da API (apps/api): banco e Valkey separados dos de desenvolvimento e dos testes do packages/db
TEST_API_DATABASE_URL=postgres://leadtogo_app:senha@localhost:5432/leadtogo_api_test
TEST_API_DATABASE_MIGRATION_URL=postgres://leadtogo_owner:senha@localhost:5432/leadtogo_api_test
TEST_REDIS_URL=redis://localhost:6379/1

# Cache e filas
REDIS_URL=redis://localhost:6379
# Worker (filas BullMQ no Valkey). WORKER_ENCERRAMENTO_S < stop timeout do Coolify (45 s): esteira_deploy.md
FILA_PREFIXO=leadtogo:fila
WORKER_CONCORRENCIA=5
WORKER_ENCERRAMENTO_S=30
WORKER_SAUDE_PORTA=3001
# Ciclo do relay do outbox e e-mail pela fila (tentativas; espera base, que dobra a cada tentativa)
OUTBOX_INTERVALO_MS=2000
EMAIL_TENTATIVAS=6
EMAIL_ESPERA_MS=5000
# Chave AES-256 que cifra os e-mails de identidade na fila (gere com: openssl rand -base64 32). Obrigatória em produção
TOKEN_ENCRYPTION_KEY=
# Rate limit por IP (Valkey): requisições por janela, no total da API
RATE_LIMIT_MAX=300
RATE_LIMIT_JANELA_S=60
# Proxies na frente da API (Traefik do Coolify). Padrão: 1 em produção, 0 fora dela
# TRUST_PROXY=1

# Arquivos (Garage / S3)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=leadtogo-arquivos
S3_FORCE_PATH_STYLE=true
# Chave de desenvolvimento (docker/garage/init.sh a importa no Garage local).
# Formato do Garage: "GK" + 24 hex e 64 hex. Em produção, gere outra no Coolify.
S3_ACCESS_KEY=GKd0d0d0d0d0d0d0d0d0d0d0d0
S3_SECRET_KEY=d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0

# E-mail (SMTP). Em desenvolvimento: Mailpit do compose (interface em http://localhost:8025).
# Produção: o provedor de SMTP ainda será escolhido (E13); até lá nenhum e-mail sai.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Leadtogo <nao-responder@leadtogo.local>"
# API HTTP do Mailpit (só os testes usam, para ler as mensagens enviadas)
MAILPIT_URL=http://localhost:8025

# Autenticação (Better Auth). O segredo assina cookies e cifra o 2FA (mín. 32 caracteres).
# Em produção gere um forte: openssl rand -base64 32. O valor abaixo é só de desenvolvimento.
BETTER_AUTH_SECRET=segredo-de-desenvolvimento-nao-use-em-producao
# Exige e-mail verificado para entrar. Padrão: sim em produção, não fora (precisa de SMTP)
# VERIFICACAO_EMAIL=true

# Criptografia de tokens de integrações (AES-256-GCM, 32 bytes em base64)
TOKEN_ENCRYPTION_KEY=

# Consulta de CNPJ
MINHA_RECEITA_URL=https://minhareceita.org

# Observabilidade
SENTRY_DSN=
APP_VERSION=dev

# Integrações (fases futuras)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
N8N_WEBHOOK_URL=
GOOGLE_MAPS_API_KEY=
# Cadastro público (POST /v1/primeiro-acesso): aberto | fechado. Padrão: aberto fora de produção e
# FECHADO em produção; lá a primeira conta nasce por `node dist/criar-conta.js` (esteira_deploy.md, 7.3)
# PRIMEIRO_ACESSO=fechado

# Login com Google (desligado por padrão). Ligar: LOGIN_GOOGLE=true com o cliente OAuth do Google Cloud
# (URI de redirecionamento: <API_URL>/v1/auth/callback/google). Só entra quem já tem conta.
# LOGIN_GOOGLE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
