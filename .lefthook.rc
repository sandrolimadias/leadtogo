# Carregado pelo lefthook antes de cada comando dos hooks (rc em lefthook.yml). Os hooks
# rodam sem o PATH do terminal interativo (commit por IDE, Claude Code), então acrescenta
# o bin do Node 24 mais recente do nvm, se existir, para achar node e pnpm.
# Não renomeie para .lefthookrc: o hook gerado o carrega sozinho com `. .lefthookrc`, que o dash não acha.
d=$(ls -d "$HOME"/.nvm/versions/node/v24*/bin 2>/dev/null | sort -V | tail -n 1)
[ -n "$d" ] && PATH="$d:$PATH" && export PATH
