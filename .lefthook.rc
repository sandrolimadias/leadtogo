# Carregado pelo lefthook antes de cada comando (rc em lefthook.yml). Não use o nome
# .lefthookrc: o hook gerado o carrega sozinho com `. .lefthookrc`, que o dash não acha. Os hooks rodam em um
# shell sem o PATH do terminal interativo (ex.: commit por IDE ou pelo Claude Code), então
# carrega o nvm, se existir, para achar o Node do .nvmrc e o pnpm.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh" --no-use
  nvm use --silent >/dev/null 2>&1 || true
fi
