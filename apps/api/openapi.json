                    "$ref": "#/components/schemas/ConviteResumo"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sem login (`nao_autenticado`) ou sessão expirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão (`acesso_negado`, `2fa_obrigatorio`, `empresa_ativa_invalida`...)",
