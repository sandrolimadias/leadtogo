{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Verifica banco, Valkey e Garage (2 s no máximo cada). 200 com tudo saudável; 503 se algum falhar, sem detalhes do erro.",
        "operationId": "HealthController_verificar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saude"
                }
              }
            }
          },
          "503": {
            "description": "Serviço indisponível (`servico_indisponivel`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "summary": "Saúde do serviço",
        "tags": ["Saúde"],
        "security": []
      }
    },
    "/v1/acesso/opcoes": {
      "get": {
        "description": "Público. Diz o que a tela de login pode oferecer. Hoje: se \"Entrar com Google\" está ligado (`LOGIN_GOOGLE` e credenciais).",
        "operationId": "AcessoPublicoController_opcoes",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpcoesDeAcesso"
                }
              }
            }
          },
          "429": {
            "description": "Muitas requisições (`muitas_requisicoes`; veja o cabeçalho `Retry-After`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "summary": "Opções da tela de login",
        "tags": ["Acesso"],
        "security": []
      }
    },
    "/v1/convites": {
      "post": {
        "description": "Só administradores da empresa ativa. Envia um e-mail com o link do convite (validade de 7 dias, uso único). O token vai SÓ por e-mail: a resposta nunca o traz e o banco guarda apenas o hash. Reenviar cancela o convite pendente anterior.",
        "operationId": "ConvitesController_criar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarConviteEntrada"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConviteCriado"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos (`validacao_invalida`, com os campos em `detalhes`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Sem login (`nao_autenticado`) ou sessão expirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão (`acesso_negado`, `2fa_obrigatorio`, `empresa_ativa_invalida`...)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "Conflito (`sem_empresa_ativa`, `ja_e_membro`, e-mail ou CNPJ já cadastrado...)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Muitas requisições (`muitas_requisicoes`; veja o cabeçalho `Retry-After`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "summary": "Convidar um membro",
        "tags": ["Equipe e convites"]
      },
      "get": {
        "description": "Só administradores da empresa ativa. Lista os convites ainda não aceitos nem cancelados (os vencidos aparecem como `expirado`). Nunca inclui o token.",
