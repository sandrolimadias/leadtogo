{
  "name": "leadtogo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "dev:up": "bash docker/dev-up.sh",
    "dev:down": "docker compose -f docker/compose.dev.yml down",
    "dev:reset": "bash docker/dev-reset.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write . '!docker/.data'",
    "format:check": "prettier --check . '!docker/.data'",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=${TURBO_CONCURRENCY:-2}",
    "db:generate": "pnpm --filter @leadtogo/db db:generate",
    "db:migrate": "pnpm --filter @leadtogo/db db:migrate",
    "db:seed": "pnpm --filter @leadtogo/db db:seed",
    "db:seed:referencias": "pnpm --filter @leadtogo/db db:seed:referencias",
    "db:studio": "pnpm --filter @leadtogo/db db:studio",
    "verificar:zero": "bash scripts/verificar-zero.sh",
    "imagens:testar": "bash docker/imagens-testar.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "secretlint": "^13.1.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
