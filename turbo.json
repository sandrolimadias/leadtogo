{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js", "docs/design-system/**"],
  "globalPassThroughEnv": ["NODE_ENV", "APP_VERSION"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      // ^build: o setup global dos testes da API importa @leadtogo/db pelo dist (como em produção)
      "dependsOn": ["transit", "^build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_MIGRATION_URL",
        "TEST_DATABASE_URL",
        "TEST_DATABASE_MIGRATION_URL",
        "TEST_API_DATABASE_URL",
        "TEST_API_DATABASE_MIGRATION_URL",
        "TEST_REDIS_URL",
        "REDIS_URL"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
